# Plex server connection
PLEX_URL=http://192.168.1.100:32400
PLEX_TOKEN=your-plex-token-here

# Optional: mirror Curatorr's permanent items to a manual Plex collection
PLEX_PERMANENT_COLLECTION_SYNC=false
PLEX_PERMANENT_COLLECTION_NAME=Permanent Exhibition

# Optional: bearer token for scheduled collection reconciliation
MAINTENANCE_TOKEN=generate-another-random-string-here

# Tautulli connection
TAUTULLI_URL=http://192.168.1.100:8181
TAUTULLI_API_KEY=your-tautulli-api-key-here

# Admin authentication
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=generate-a-random-string-here

# Set to "true" only if serving behind HTTPS (e.g. via reverse proxy with SSL)
# Leave unset or "false" for plain HTTP access (typical Unraid LAN setup)
SECURE_COOKIES=false

# Seerr (optional) — enables deleting media files + requests via Seerr
SEERR_URL=http://192.168.1.100:5055
SEERR_API_KEY=your-seerr-api-key-here
